{
  "name": "hands-on-superset-in-react",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo with NestJS backend and React UI",
  "scripts": {
    "dev:back": "pnpm --filter back dev",
    "dev:ui": "pnpm --filter ui dev",
    "build:back": "pnpm --filter back build",
    "build:ui": "pnpm --filter ui build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
